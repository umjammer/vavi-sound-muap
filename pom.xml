      <artifactId>vavi-sound-mdsound</artifactId>
      <version>0.0.30</version>
      <exclusions>
        <exclusion>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>jackson-databind</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
<dependency>
